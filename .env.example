# Copie para .env (o instalar.ps1 faz isso). NUNCA versione o .env nem mande a ninguém. Tokens e chaves só aqui.
# Cada pessoa usa as próprias contas. Preencha só o que for usar.

# --- Voz (ElevenLabs) ---
# A voz é gerada pelo Claude via conector do ElevenLabs (.mcp.json). A chave abaixo serve ao conector
# e à leitura do saldo (orquestrador). Crie uma chave em elevenlabs.io → Developers → API Keys.
ELEVENLABS_API_KEY=

# --- Instagram / Meta (guia: _sistema/briefs/configurar-meta.md) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0   # confirme a versão atual da Graph API
META_TOKEN_CURTO=          # temporário: token do Explorador da Graph API; meta_token.py troca pelo definitivo e apaga
# Por perfil (os nomes saem de perfil.yaml → user_id_env / token_env). Exemplo para o prefixo "mpf":
# IG_USER_ID_MPF=
# IG_TOKEN_MPF=

# --- Alertas (opcional) ---
ALERT_EMAIL=
ALERT_WEBHOOK=

# --- Google Drive para computador (opcional): pasta sincronizada; vazio = desligado ---
DRIVE_PASTA=

# --- Cross-post (opcional): YouTube / TikTok / Zernio. Veja CHAVES-PERFIL.md, seção 10 ---
ZERNIO_API_KEY=
# YT_CLIENT_ID_<X>= YT_CLIENT_SECRET_<X>= YT_REFRESH_TOKEN_<X>=
# TT_CLIENT_KEY_<X>= TT_CLIENT_SECRET_<X>= TT_REFRESH_TOKEN_<X>=
